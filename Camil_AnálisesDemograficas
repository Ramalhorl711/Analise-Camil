-- A.1 Orig. Mensal
SELECT
	EOMONTH(DATA_EMISSAO) AS 'MES_EMISSAO',
	SUM(VALOR_RECEBIVEL)/1000 AS 'VALOR_DOS_TITULOS',
	COUNT(ID) AS 'QTD_TITULOS',
	AVG(VALOR_RECEBIVEL) AS 'VALOR_MEDIO_TITULOS',
	AVG(DATEDIFF(DAY, DATA_EMISSAO, VENCIMENTO_ORIGINAL)) AS 'PRAZO_MEDIO'
from [dbo].[A02_Camil_Tratado]
GROUP BY EOMONTH(DATA_EMISSAO)
ORDER BY EOMONTH(DATA_EMISSAO) ASC
 
-- A.2 Faixas Valor
WITH FAIXAS AS (
	SELECT
		CASE
			WHEN VALOR_RECEBIVEL <= 1000 THEN '1.Até R$ 1.000'
			WHEN VALOR_RECEBIVEL <= 2500 THEN '2.De R$ 1.000,01 a R$ 2.500,00'
			WHEN VALOR_RECEBIVEL <= 5000 THEN '3.De R$ 2.500,01 a R$ 5.000,00'
			WHEN VALOR_RECEBIVEL <= 10000 THEN '4.De R$ 5.000,01 a R$ 10.000,00'
			WHEN VALOR_RECEBIVEL <= 20000 THEN '5.De R$ 10.000,01 a R$ 20.000,00'
			WHEN VALOR_RECEBIVEL <= 50000 THEN '6.De R$ 20.000,01 a R$ 50.000,00'
			WHEN VALOR_RECEBIVEL <= 100000 THEN '7.De R$ 50.000,01 a R$ 100.000,00'
			WHEN VALOR_RECEBIVEL <= 200000 THEN '8.De R$ 100.000,01 a R$ 200.000,00'
			ELSE '9.Acima de R$ 200.000,00'
		END AS FAIXA_VALOR,
		SUM(VALOR_RECEBIVEL)/1000 AS VALOR_RECEBIVEL, 
		COUNT(ID) AS QTD_TITULOS
	FROM [dbo].[A02_Camil_Tratado]
	GROUP BY 
		CASE
			WHEN VALOR_RECEBIVEL <= 1000 THEN '1.Até R$ 1.000'
			WHEN VALOR_RECEBIVEL <= 2500 THEN '2.De R$ 1.000,01 a R$ 2.500,00'
			WHEN VALOR_RECEBIVEL <= 5000 THEN '3.De R$ 2.500,01 a R$ 5.000,00'
			WHEN VALOR_RECEBIVEL <= 10000 THEN '4.De R$ 5.000,01 a R$ 10.000,00'
			WHEN VALOR_RECEBIVEL <= 20000 THEN '5.De R$ 10.000,01 a R$ 20.000,00'
			WHEN VALOR_RECEBIVEL <= 50000 THEN '6.De R$ 20.000,01 a R$ 50.000,00'
			WHEN VALOR_RECEBIVEL <= 100000 THEN '7.De R$ 50.000,01 a R$ 100.000,00'
			WHEN VALOR_RECEBIVEL <= 200000 THEN '8.De R$ 100.000,01 a R$ 200.000,00'
			ELSE '9.Acima de R$ 200.000,00'
		END
)
SELECT * 
FROM FAIXAS
ORDER BY FAIXA_VALOR ASC;
 
-- A.3 Faixas Prazo
WITH FAIXAS_PRAZO AS (
	SELECT
		CASE
			WHEN DATEDIFF(DAY,DATA_EMISSAO, VENCIMENTO_ORIGINAL) <= 30 THEN '1.Até 30 dias'
			WHEN DATEDIFF(DAY,DATA_EMISSAO, VENCIMENTO_ORIGINAL) <= 45 THEN '2.De 31 a 45 dias'
			WHEN DATEDIFF(DAY,DATA_EMISSAO, VENCIMENTO_ORIGINAL) <= 60 THEN '3.De 46 a 60 dias'
			WHEN DATEDIFF(DAY,DATA_EMISSAO, VENCIMENTO_ORIGINAL) <= 75 THEN '4.De 61 a 75 dias'
			WHEN DATEDIFF(DAY,DATA_EMISSAO, VENCIMENTO_ORIGINAL) <= 90 THEN '5.De 76 a 90 dias'
			WHEN DATEDIFF(DAY,DATA_EMISSAO, VENCIMENTO_ORIGINAL) > 90 THEN '6.Acima de 90 dias'
		END AS FAIXA_PRAZO,
		SUM(VALOR_RECEBIVEL)/1000 AS VALOR_RECEBIVEL, 
		COUNT(ID) AS QTD_TITULOS
	FROM [dbo].[A02_Camil_Tratado]
	GROUP BY 
		CASE
			WHEN DATEDIFF(DAY,DATA_EMISSAO, VENCIMENTO_ORIGINAL) <= 30 THEN '1.Até 30 dias'
			WHEN DATEDIFF(DAY,DATA_EMISSAO, VENCIMENTO_ORIGINAL) <= 45 THEN '2.De 31 a 45 dias'
			WHEN DATEDIFF(DAY,DATA_EMISSAO, VENCIMENTO_ORIGINAL) <= 60 THEN '3.De 46 a 60 dias'
			WHEN DATEDIFF(DAY,DATA_EMISSAO, VENCIMENTO_ORIGINAL) <= 75 THEN '4.De 61 a 75 dias'
			WHEN DATEDIFF(DAY,DATA_EMISSAO, VENCIMENTO_ORIGINAL) <= 90 THEN '5.De 76 a 90 dias'
			WHEN DATEDIFF(DAY,DATA_EMISSAO, VENCIMENTO_ORIGINAL) > 90 THEN '6.Acima de 90 dias'
		END
)
SELECT * 
FROM FAIXAS_PRAZO
ORDER BY FAIXA_PRAZO ASC;
 
-- A.4 Vcto Mensal
SELECT
	EOMONTH(VENCIMENTO_ORIGINAL) AS 'MES_VENCIMENTO_ORIGINAL',
	SUM(VALOR_RECEBIVEL)/1000 AS 'VALOR_DOS_TITULOS',
	COUNT(ID) AS 'QTD_TITULOS',
	AVG(VALOR_RECEBIVEL) AS 'VALOR_MEDIO_TITULOS',
	AVG(DATEDIFF(DAY, DATA_EMISSAO, VENCIMENTO_ORIGINAL)) AS 'PRAZO_MEDIO'
from [dbo].[A02_Camil_Tratado]
GROUP BY EOMONTH(VENCIMENTO_ORIGINAL)
ORDER BY EOMONTH(VENCIMENTO_ORIGINAL) ASC
 
-- A.5 Conc UF
SELECT
	ESTADO_DEVEDOR,
	SUM(VALOR_RECEBIVEL)/1000 AS 'VALOR_DOS_TITULOS',
	COUNT(ID) AS 'QTD_TITULOS',
	AVG(VALOR_RECEBIVEL) AS 'VALOR_MEDIO_TITULOS',
	AVG(DATEDIFF(DAY, DATA_EMISSAO, VENCIMENTO_ORIGINAL)) AS 'PRAZO_MEDIO'
from [dbo].[A02_Camil_Tratado]
GROUP BY ESTADO_DEVEDOR
ORDER BY SUM(VALOR_RECEBIVEL) DESC
 
-- A.6 Conc UF Mensal
SELECT
	EOMONTH(DATA_EMISSAO) AS 'MES_EMISSAO',
	ESTADO_DEVEDOR,
	SUM(VALOR_RECEBIVEL)/1000 AS 'VALOR_DOS_TITULOS'
FROM [dbo].[A02_Camil_Tratado]
GROUP BY EOMONTH(DATA_EMISSAO), ESTADO_DEVEDOR
ORDER BY EOMONTH(DATA_EMISSAO) DESC
 
-- A.7 Conc Clientes Consolidado
WITH CNPJ_RAIZ AS (
SELECT
	*,
	LEFT(CPF_CNPJ_DEVEDOR,10) AS 'RAIZ_CPF_CNPJ'
FROM [dbo].[A02_Camil_Tratado])
SELECT DISTINCT (RAIZ_CPF_CNPJ),
	MAX(CPF_CNPJ_DEVEDOR) AS 'CPF_CNPJ_DEVEDOR',
	MAX(NOME_DEVEDOR) AS 'NOME_DEVEDOR',
	MAX(ESTADO_DEVEDOR) AS 'ESTADO_DEVEDOR',
	SUM(VALOR_RECEBIVEL) AS 'VALOR_RECEBIVEL',
	COUNT(ID) AS 'QTDE_TITULOS'
FROM CNPJ_RAIZ
GROUP BY RAIZ_CPF_CNPJ
ORDER BY RAIZ_CPF_CNPJ ASC
 
-- A.7 Conc Clientes Evol. Anual
WITH CNPJ_RAIZ AS (
SELECT
	*,
	LEFT(CPF_CNPJ_DEVEDOR,10) AS 'RAIZ_CPF_CNPJ',
	CASE
		WHEN DATA_EMISSAO >= '2022-03-01' AND DATA_EMISSAO <= '2023-02-28' THEN '2022'
		WHEN DATA_EMISSAO >= '2023-03-01' AND DATA_EMISSAO <= '2024-02-29' THEN '2023'
		WHEN DATA_EMISSAO >= '2024-03-01' AND DATA_EMISSAO <= '2025-02-28' THEN '2024'
		WHEN DATA_EMISSAO >= '2025-03-01' AND DATA_EMISSAO <= '2025-08-31' THEN '2025'
		WHEN DATA_EMISSAO > '2025-08-31' THEN '2025.2'
	END AS 'PERIODO_EMISSAO'
FROM [dbo].[A02_Camil_Tratado])
SELECT DISTINCT (RAIZ_CPF_CNPJ),
	MAX(PERIODO_EMISSAO) AS 'PERIODO',
	MAX(CPF_CNPJ_DEVEDOR) AS 'CPF_CNPJ_DEVEDOR',
	MAX(NOME_DEVEDOR) AS 'NOME_DEVEDOR',
	MAX(ESTADO_DEVEDOR) AS 'ESTADO_DEVEDOR',
	SUM(VALOR_RECEBIVEL) AS 'VALOR_RECEBIVEL',
	COUNT(ID) AS 'QTDE_TITULOS'
FROM CNPJ_RAIZ
GROUP BY RAIZ_CPF_CNPJ, PERIODO_EMISSAO
ORDER BY RAIZ_CPF_CNPJ  ASC
