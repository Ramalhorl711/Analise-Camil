--IF OBJECT_ID('[dbo].[A03_Camil_Aging]', 'U') IS NOT NULL
--    DROP TABLE [dbo].[A03_Camil_Aging];
DECLARE @DATABASE DATE;
SET @DATABASE ='2025-09-30';
 
WITH AGING_LIST as(
	SELECT *,
		CASE
		    WHEN [DATA_RENEG] IS NOT NULL THEN 'A001.Renegociacao'
			WHEN [IND_DEVOLUCAO] IS NOT NULL AND [IND_DEVOLUCAO] <> 0 THEN 'A002.Devolucao'
			WHEN [STATUS] = 'Acerto Interno' THEN 'A003.Acerto Interno'
			WHEN DATEDIFF(DAY, @DATABASE, [VENCIMENTO_ORIGINAL]) >= 0 AND [DATA_PAGAMENTO] IS NULL THEN 'A01.Parcelas a Vencer'
			WHEN DATEDIFF(DAY, [DATA_PAGAMENTO], [VENCIMENTO_ORIGINAL]) > 360 THEN  'A02.Parcelas antecipadas acima de 360 dias'
			WHEN DATEDIFF(DAY, [DATA_PAGAMENTO], [VENCIMENTO_ORIGINAL]) > 180 THEN  'A03.Parcelas antecipadas de 181 a 360 dias'
			WHEN DATEDIFF(DAY, [DATA_PAGAMENTO], [VENCIMENTO_ORIGINAL]) > 150 THEN  'A04.Parcelas antecipadas de 151 a 180 dias'
			WHEN DATEDIFF(DAY, [DATA_PAGAMENTO], [VENCIMENTO_ORIGINAL]) > 120 THEN  'A05.Parcelas antecipadas de 121 a 150 dias'
			WHEN DATEDIFF(DAY, [DATA_PAGAMENTO], [VENCIMENTO_ORIGINAL]) > 90 THEN  'A06.Parcelas antecipadas de 91 a 120 dias'
			WHEN DATEDIFF(DAY, [DATA_PAGAMENTO], [VENCIMENTO_ORIGINAL]) > 60 THEN  'A07.Parcelas antecipadas de 61 a 90 dias'
			WHEN DATEDIFF(DAY, [DATA_PAGAMENTO], [VENCIMENTO_ORIGINAL]) > 30 THEN  'A08.Parcelas antecipadas de 31 a 60 dias'
			WHEN DATEDIFF(DAY, [DATA_PAGAMENTO], [VENCIMENTO_ORIGINAL]) > 15 THEN  'A09.Parcelas antecipadas de 16 a 30 dias'
			WHEN DATEDIFF(DAY, [DATA_PAGAMENTO], [VENCIMENTO_ORIGINAL]) > 7 THEN  'A10.Parcelas antecipadas de 8 a 15 dias'
			WHEN DATEDIFF(DAY, [DATA_PAGAMENTO], [VENCIMENTO_ORIGINAL]) > 2 THEN  'A11.Parcelas antecipadas de 3 a 7 dias'
			WHEN DATEDIFF(DAY, [DATA_PAGAMENTO], [VENCIMENTO_ORIGINAL]) > 0 THEN  'A12.Parcelas antecipadas de 1 a 2 dias'
			WHEN DATEDIFF(DAY, [DATA_PAGAMENTO], [VENCIMENTO_ORIGINAL]) = 0 THEN  'A13.Parcelas liquidadas no vencimento'
			WHEN DATEDIFF(DAY, [DATA_PAGAMENTO], [VENCIMENTO_ORIGINAL]) < -360 THEN  'A24.Parcelas liquidadas acima de 360 dias'
			WHEN DATEDIFF(DAY, [DATA_PAGAMENTO], [VENCIMENTO_ORIGINAL]) < -180 THEN  'A23.Parcelas liquidadas de 181 a 360 dias'
			WHEN DATEDIFF(DAY, [DATA_PAGAMENTO], [VENCIMENTO_ORIGINAL]) < -150 THEN  'A22.Parcelas liquidadas de 151 a 180 dias'
			WHEN DATEDIFF(DAY, [DATA_PAGAMENTO], [VENCIMENTO_ORIGINAL]) < -120 THEN  'A21.Parcelas liquidadas de 121 a 150 dias'
			WHEN DATEDIFF(DAY, [DATA_PAGAMENTO], [VENCIMENTO_ORIGINAL]) < -90 THEN  'A20.Parcelas liquidadas de 91 a 120 dias'
			WHEN DATEDIFF(DAY, [DATA_PAGAMENTO], [VENCIMENTO_ORIGINAL]) < -60 THEN  'A19.Parcelas liquidadas de 61 a 90 dias'
			WHEN DATEDIFF(DAY, [DATA_PAGAMENTO], [VENCIMENTO_ORIGINAL]) < -30 THEN  'A18.Parcelas liquidadas de 31 a 60 dias'
			WHEN DATEDIFF(DAY, [DATA_PAGAMENTO], [VENCIMENTO_ORIGINAL]) < -15 THEN  'A17.Parcelas liquidadas de 16 a 30 dias'
			WHEN DATEDIFF(DAY, [DATA_PAGAMENTO], [VENCIMENTO_ORIGINAL]) < -7 THEN  'A16.Parcelas liquidadas de 8 a 15 dias'
			WHEN DATEDIFF(DAY, [DATA_PAGAMENTO], [VENCIMENTO_ORIGINAL]) < -2 THEN  'A15.Parcelas liquidadas de 3 a 7 dias'
			WHEN DATEDIFF(DAY, [DATA_PAGAMENTO], [VENCIMENTO_ORIGINAL]) < 0 THEN  'A14.Parcelas liquidadas de 1 a 2 dias'
			WHEN DATEDIFF(DAY, @DATABASE, [VENCIMENTO_ORIGINAL]) < -360 AND [DATA_PAGAMENTO] IS NULL THEN  'A35.Parcelas vencidas acima de 360 dias'
			WHEN DATEDIFF(DAY, @DATABASE, [VENCIMENTO_ORIGINAL]) < -180 AND [DATA_PAGAMENTO] IS NULL THEN  'A34.Parcelas vencidas de 181 a 360 dias'
			WHEN DATEDIFF(DAY, @DATABASE, [VENCIMENTO_ORIGINAL]) < -150 AND [DATA_PAGAMENTO] IS NULL THEN  'A33.Parcelas vencidas de 151 a 180 dias'
			WHEN DATEDIFF(DAY, @DATABASE, [VENCIMENTO_ORIGINAL]) < -120 AND [DATA_PAGAMENTO] IS NULL THEN  'A32.Parcelas vencidas de 121 a 150 dias'
			WHEN DATEDIFF(DAY, @DATABASE, [VENCIMENTO_ORIGINAL]) < -90 AND [DATA_PAGAMENTO] IS NULL THEN  'A31.Parcelas vencidas de 91 a 120 dias'
			WHEN DATEDIFF(DAY, @DATABASE, [VENCIMENTO_ORIGINAL]) < -60 AND [DATA_PAGAMENTO] IS NULL THEN  'A30.Parcelas vencidas de 61 a 90 dias'
			WHEN DATEDIFF(DAY, @DATABASE, [VENCIMENTO_ORIGINAL]) < -30 AND [DATA_PAGAMENTO] IS NULL THEN  'A29.Parcelas vencidas de 31 a 60 dias'
			WHEN DATEDIFF(DAY, @DATABASE, [VENCIMENTO_ORIGINAL]) < -15 AND [DATA_PAGAMENTO] IS NULL THEN  'A28.Parcelas vencidas de 16 a 30 dias'
			WHEN DATEDIFF(DAY, @DATABASE, [VENCIMENTO_ORIGINAL]) < -7 AND [DATA_PAGAMENTO] IS NULL THEN  'A27.Parcelas vencidas de 8 a 15 dias'
			WHEN DATEDIFF(DAY, @DATABASE, [VENCIMENTO_ORIGINAL]) < -3 AND [DATA_PAGAMENTO] IS NULL THEN  'A26.Parcelas vencidas de 4 a 7 dias'
			WHEN DATEDIFF(DAY, @DATABASE, [VENCIMENTO_ORIGINAL]) < 0 AND [DATA_PAGAMENTO] IS NULL THEN  'A25.Parcelas vencidas até 3 dias'
		ELSE 'CHECK'
	END AS 'Aging_List',
	IIF([DATA_PAGAMENTO] IS NOT NULL AND [VALOR_PAGO] > [VALOR_RECEBIVEL], [VALOR_PAGO] - [VALOR_RECEBIVEL], NULL) AS 'MULTA',
	IIF([DATA_PAGAMENTO] IS NOT NULL AND [VALOR_PAGO] < [VALOR_RECEBIVEL], [VALOR_RECEBIVEL] - [VALOR_PAGO], NULL) AS 'DESCONTO'
	FROM dbo.A02_Camil_Tratado
	WHERE TIPO_TITULO = 'Duplicata')
,MATRIZ AS (
	SELECT * ,
		CASE 
			WHEN [IND_DEVOLUCAO] IS NOT NULL AND [IND_DEVOLUCAO] <> 0 THEN [DATA_PAGAMENTO]
			ELSE NULL
			END AS DATA_DEVOLUCAO,
		CASE
		    WHEN [DATA_RENEG] IS NOT NULL THEN 'A001.Renegociacao'
			WHEN [IND_DEVOLUCAO] IS NOT NULL AND [IND_DEVOLUCAO] <> 0 THEN 'A002.Devolucao'
			WHEN [STATUS] = 'Acerto Interno' THEN 'A003.Acerto Interno'
			WHEN [DATA_PAGAMENTO] IS NULL THEN 'A01.Parcelas em Aberto'
			WHEN DATEDIFF(DAY, [DATA_PAGAMENTO], [VENCIMENTO_ORIGINAL]) > 0 THEN  'A02.Parcelas antecipadas'
			WHEN DATEDIFF(DAY, [DATA_PAGAMENTO], [VENCIMENTO_ORIGINAL]) = 0 THEN  'A03.Parcelas liquidadas no vencimento'
			WHEN DATEDIFF(DAY, [DATA_PAGAMENTO], [VENCIMENTO_ORIGINAL]) < -360 THEN  'A16.Parcelas liquidadas acima de 360 dias'
			WHEN DATEDIFF(DAY, [DATA_PAGAMENTO], [VENCIMENTO_ORIGINAL]) < -330 THEN  'A15.Parcelas liquidadas de 331 a 360 dias'
			WHEN DATEDIFF(DAY, [DATA_PAGAMENTO], [VENCIMENTO_ORIGINAL]) < -300 THEN  'A14.Parcelas liquidadas de 301 a 330 dias'
			WHEN DATEDIFF(DAY, [DATA_PAGAMENTO], [VENCIMENTO_ORIGINAL]) < -270 THEN  'A13.Parcelas liquidadas de 271 a 300 dias'
			WHEN DATEDIFF(DAY, [DATA_PAGAMENTO], [VENCIMENTO_ORIGINAL]) < -240 THEN  'A12.Parcelas liquidadas de 241 a 270 dias'
			WHEN DATEDIFF(DAY, [DATA_PAGAMENTO], [VENCIMENTO_ORIGINAL]) < -210 THEN  'A11.Parcelas liquidadas de 211 a 240 dias'
			WHEN DATEDIFF(DAY, [DATA_PAGAMENTO], [VENCIMENTO_ORIGINAL]) < -180 THEN  'A10.Parcelas liquidadas de 181 a 210 dias'
			WHEN DATEDIFF(DAY, [DATA_PAGAMENTO], [VENCIMENTO_ORIGINAL]) < -150 THEN  'A09.Parcelas liquidadas de 151 a 180 dias'
			WHEN DATEDIFF(DAY, [DATA_PAGAMENTO], [VENCIMENTO_ORIGINAL]) < -120 THEN  'A08.Parcelas liquidadas de 121 a 150 dias'
			WHEN DATEDIFF(DAY, [DATA_PAGAMENTO], [VENCIMENTO_ORIGINAL]) < -90 THEN  'A07.Parcelas liquidadas de 91 a 120 dias'
			WHEN DATEDIFF(DAY, [DATA_PAGAMENTO], [VENCIMENTO_ORIGINAL]) < -60 THEN  'A06.Parcelas liquidadas de 61 a 90 dias'
			WHEN DATEDIFF(DAY, [DATA_PAGAMENTO], [VENCIMENTO_ORIGINAL]) < -30 THEN  'A05.Parcelas liquidadas de 31 a 60 dias'
			WHEN DATEDIFF(DAY, [DATA_PAGAMENTO], [VENCIMENTO_ORIGINAL]) < 0 THEN  'A04.Parcelas liquidadas de 1 a 30'
			ELSE 'EM_ABERTO'
		END AS 'MATRIZ'
	FROM dbo.A02_Camil_Tratado
	WHERE TIPO_TITULO = 'Duplicata')
 
-- B.3 Matriz
SELECT
	EOMONTH(VENCIMENTO_ORIGINAL) AS 'MES_VENCIMENTO',
	MATRIZ,
	SUM(VALOR_RECEBIVEL) AS 'VALOR_TITULOS',
	AVG(DATEDIFF(DAY, DATA_DEVOLUCAO, VENCIMENTO_ORIGINAL)) AS 'PRAZO_MEDIO'
FROM MATRIZ
GROUP BY EOMONTH(VENCIMENTO_ORIGINAL), MATRIZ
ORDER BY EOMONTH(VENCIMENTO_ORIGINAL), MATRIZ ASC
